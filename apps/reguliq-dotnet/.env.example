# Reguliq .NET — environment template (copy to repo root .env or export locally)
# Do NOT commit real secrets.

# API
REGULIQ_API_PORT=5100
REGULIQ_USE_POSTGRES=false
# REGULIQ_DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
# DIRECT_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# Phase 1 bridge (NestJS Landing AI + Supabase cache)
NODE_API_URL=http://localhost:4000

# Phase 2 Gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite

# Kafka / Azure Event Hubs (optional — local queue when disabled)
KAFKA_ENABLED=false
KAFKA_BROKERS=
KAFKA_CLIENT_ID=bcp-dual-verify
KAFKA_CONSUMER_GROUP=dual-verify-workers-v1
KAFKA_TOPIC_JOBS=dual-verify-jobs
KAFKA_TOPIC_RETRY=dual-verify-retry
KAFKA_TOPIC_DLQ=dual-verify-dlq
KAFKA_TOPIC_RESULTS=dual-verify-results
# KAFKA_PRODUCER_CONNECTION_STRING=
# KAFKA_CONSUMER_CONNECTION_STRING=
# KAFKA_WORKER_SEND_CONNECTION_STRING=
# KAFKA_SASL_PASSWORD=

# Worker
DUAL_VERIFY_WORKER_CONCURRENCY=2
DUAL_VERIFY_MAX_RETRIES=3
DUAL_VERIFY_DATA_DIR=
# DUAL_VERIFY_INTERNAL_PDF_PATH=../../web/public/default-docs/imptfs.pdf

# Angular (document for local dev — set in client/reguliq-web/src/environments/environment.ts)
# REGULIQ_WEB_API_URL=http://localhost:5100
