# BCP API — environment template
# Copy to .env in this folder (same directory as Bcp.Api.csproj)

BCP_API_PORT=5100
REGULIQ_API_PORT=5100
REGULIQ_USE_POSTGRES=false
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# Optional NestJS bridge (Landing AI Phase 1) — only if you run apps/api separately
NODE_API_URL=http://localhost:4000

# Gemini (dual verify Phase 2)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite

# CORS — Angular dev + Azure
BCP_CORS_ORIGINS=http://localhost:3002,https://bcp-web.azurewebsites.net

# Kafka (set KAFKA_ENABLED=false for local in-process queue)
KAFKA_ENABLED=false
KAFKA_BROKERS=
KAFKA_CLIENT_ID=bcp-dual-verify
KAFKA_CONSUMER_GROUP=dual-verify-workers-v1
KAFKA_TOPIC_JOBS=dual-verify-jobs
KAFKA_TOPIC_RETRY=dual-verify-retry
KAFKA_TOPIC_DLQ=dual-verify-dlq
KAFKA_TOPIC_RESULTS=dual-verify-results

DUAL_VERIFY_WORKER_CONCURRENCY=2
DUAL_VERIFY_MAX_RETRIES=3
