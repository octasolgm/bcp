# BCP API — environment template
# Copy to .env in this folder (same directory as Bcp.Api.csproj)

BCP_API_PORT=5100

# REQUIRED — Session pooler URI from Supabase Dashboard → Settings → Database
# (Do NOT use db.*.supabase.co direct host on Windows — it is IPv6-only.)
REGULIQ_USE_POSTGRES=true
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Or paste the full URI Supabase shows when you pick "Session pooler" + "URI"

# Import local SQLite + JSON sessions into Supabase on startup (default true)
MIGRATE_LOCAL_DATA_TO_SUPABASE=true

# Emergency local-only dev (not shared across team) — do not use for team setup
# BCP_ALLOW_SQLITE=true
# REGULIQ_USE_POSTGRES=false

# Gemini (dual verify Phase 2)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-lite

# Optional NestJS bridge (Landing AI Phase 1)
NODE_API_URL=http://localhost:4000

# CORS — Angular dev + Azure
BCP_CORS_ORIGINS=http://localhost:3002,https://bcp-web.azurewebsites.net

# Kafka
KAFKA_ENABLED=false
KAFKA_BROKERS=
KAFKA_CLIENT_ID=bcp-dual-verify
KAFKA_CONSUMER_GROUP=dual-verify-workers-v1
KAFKA_TOPIC_JOBS=dual-verify-jobs
KAFKA_TOPIC_RETRY=dual-verify-retry
KAFKA_TOPIC_DLQ=dual-verify-dlq
KAFKA_TOPIC_RESULTS=dual-verify-results

DUAL_VERIFY_WORKER_CONCURRENCY=2
DUAL_VERIFY_MAX_RETRIES=3
