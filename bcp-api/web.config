<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the Azure App Service host. The SDK adds the aspNetCore handler to this file at publish
  time, so only our own settings belong here.

  Both entries below stop the server advertising what it runs on. The app already suppresses Kestrel's own
  Server header (Program.cs, AddServerHeader = false), but on App Service the request also passes through
  IIS, which adds "Server: Microsoft-IIS/10.0" and "X-Powered-By: ASP.NET" of its own afterwards - app
  middleware cannot remove those, which is why they are set here.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
