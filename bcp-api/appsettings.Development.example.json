{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Bcp": {
    "ApiPort": 5100,
    "CorsOrigins": "http://localhost:3002,https://bcp-web-dev.azurewebsites.net",
    "RequireSupabase": false,
    "UsePostgres": true,
    "MigrateLocalDataToSupabase": true
  },
  "ConnectionStrings": {
    "PostgreSQL": "postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres",
    "DirectUrl": "postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
  },
  "Supabase": {
    "DbHost": "aws-0-YOUR_REGION.pooler.supabase.com",
    "DbPort": 6543,
    "DbUser": "postgres.YOUR_PROJECT_REF",
    "DbPassword": "YOUR_DB_PASSWORD",
    "DbName": "postgres"
  },
  "Gemini": {
    "ApiKey": "your-gemini-api-key",
    "DefaultModel": "gemini-3.5-flash"
  },
  "LandingAi": {
    "ApiKey": "your-vision-agent-api-key",
    "ApiBase": "https://api.va.landing.ai",
    "ParseModel": "dpt-2-latest",
    "ExtractModel": "extract-latest"
  },
  "NodeBridge": {
    "BaseUrl": "http://localhost:5100",
    "Enabled": false
  },
  "KAFKA_ENABLED": true,
  "KAFKA_BROKERS": "",
  "KAFKA_SASL_USERNAME": "$ConnectionString",
  "KAFKA_PRODUCER_CONNECTION_STRING": "",
  "KAFKA_CONSUMER_CONNECTION_STRING": "",
  "KAFKA_WORKER_SEND_CONNECTION_STRING": "",
  "KAFKA_CLIENT_ID": "bcp-dual-verify",
  "KAFKA_CONSUMER_GROUP": "dual-verify-workers-v1",
  "KAFKA_TOPIC_JOBS": "dual-verify-jobs",
  "KAFKA_TOPIC_RETRY": "dual-verify-retry",
  "KAFKA_TOPIC_DLQ": "dual-verify-dlq",
  "KAFKA_TOPIC_RESULTS": "dual-verify-results",
  "DUAL_VERIFY_WORKER_CONCURRENCY": 2,
  "DUAL_VERIFY_MAX_RETRIES": 3
}
