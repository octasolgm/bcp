# Secrets (local dev only — copy from appsettings.Development.example.json)
bcp-api/appsettings.Development.json
bcp-api/appsettings.Secrets.json
bcp-api/appsettings.*-old*.json

# Local-only Python services for OCR library evaluation (see docs/pipeline/) — each has its own venv
# and downloaded model weights, multi-GB, never committed. Only the .py source files are tracked.
docling-service/venv/
docling-service/__pycache__/
docling-service/*.txt
docling-service/*.pdf
surya-service/

# Large OCR trained-data binaries, downloaded once per environment rather than committed
bcp-api/tessdata/

# Generated at build/deploy time, not source
bcp-api/deploy-version.json
bcp-web/public/assets/deploy-version.json

# .NET build + runtime artifacts
bcp-api/bin/
bcp-api/obj/
bcp-api/publish/
bcp-api/publish_old_*/
bcp-api/publish-secrets-test/
bcp-api/_buildcheck*/
bcp-api/_buildlog/
bcp-api/_publishcheck*/
bcp-api/_runout/
bcp-api/_testbuild/
bcp-api/_testout/
bcp-api/bcp-api.zip
bcp-api/Properties/PublishProfiles/* - *1.pubxml
bcp-api/.vs/
bcp-api/TestResults/
bcp-api/**/reguliq.db
bcp-api/**/*.db-shm
bcp-api/**/*.db-wal
bcp-api/**/dual-verify-kafka/
*.user
*.suo

# Angular
bcp-web/node_modules/
bcp-web/.angular/
bcp-web/dist/
bcp-web/bcp-web-dist.zip

# Temp
tmp-*.txt

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Claude Code local session state (worktrees, local permission overrides) — launch.json is tracked
.claude/settings.local.json
.claude/worktrees/

# One-off local backups and captured build/console output, not source
bcp-api/backups/
bcp-api/scripts/__pycache__/
bcp-api/scripts/*-old.ps1
bcp-api/scripts/supabase/*-old.sql
bcp-web/bo.txt
bcp-web/src/environments/environment-old*.ts
tools/db-test/bin/
tools/db-test/obj/
